<Window x:Class="WinHotCorner.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Text comes from Strings\<language>\Resources.resw: x:Uid here, ResourceLoader in code -->

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer>
        <!-- The Grid takes the viewport's width; a MaxWidth panel straight in the ScrollViewer is placed off centre
             once the window is wider than it -->
        <Grid>
            <StackPanel MaxWidth="1000" Margin="36,28,36,36" Spacing="4">

                <Grid ColumnSpacing="16" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinHotCorner" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="HeaderTitle" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="ms-appx:///Assets/Logo.png" Width="160" Height="160" FlowDirection="LeftToRight"
                           AutomationProperties.AccessibilityView="Raw" />
                </Grid>

                <InfoBar x:Name="NotInstalledInfo" x:Uid="NotInstalledInfo" Severity="Warning" IsClosable="False" />
                <InfoBar x:Name="PolicyInfo" x:Uid="PolicyInfo" Severity="Informational" IsClosable="False" />

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7C4;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="HotCornerTitle" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="RunNowButton" x:Uid="RunNowButton" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="RunNowButton_Click" />
                        <TextBlock x:Name="EnabledState" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <ToggleSwitch x:Name="EnabledSwitch" x:Uid="EnabledSwitch" Style="{StaticResource CardToggleSwitchStyle}"
                                      Toggled="EnabledSwitch_Toggled" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Uid="PreferencesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,28,0,8" />

                <!-- The choices are too long to sit next to the text, so the box goes below it -->
                <Grid Style="{StaticResource CardStyle}" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="ScreensTitle" />
                        <TextBlock x:Uid="ScreensDescription"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ScreensBox" Grid.Row="1" Grid.Column="1"
                              x:Uid="ScreensBox" SelectionChanged="ScreensBox_SelectionChanged" />
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7FA;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="HoldTitle" />
                        <TextBlock x:Uid="HoldDescription" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="HoldState" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <ToggleSwitch x:Name="HoldSwitch" x:Uid="HoldSwitch" Style="{StaticResource CardToggleSwitchStyle}"
                                      Toggled="HoldSwitch_Toggled" />
                    </StackPanel>
                </Grid>

                <!-- Only when Windows' display language is written right to left -->
                <Grid x:Name="RightToLeftCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8AB;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="MirrorTitle" />
                        <TextBlock x:Uid="MirrorDescription"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="RightToLeftState" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <ToggleSwitch x:Name="RightToLeftSwitch" Style="{StaticResource CardToggleSwitchStyle}"
                                      x:Uid="RightToLeftSwitch" Toggled="RightToLeftSwitch_Toggled" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE740;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="FullscreenTitle" />
                        <TextBlock x:Uid="FullscreenDescription"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="FullscreenState" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <ToggleSwitch x:Name="FullscreenSwitch" Style="{StaticResource CardToggleSwitchStyle}"
                                      x:Uid="FullscreenSwitch" Toggled="FullscreenSwitch_Toggled" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE962;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="MouseDownTitle" />
                        <TextBlock x:Uid="MouseDownDescription"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="MouseDownState" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <ToggleSwitch x:Name="MouseDownSwitch" Style="{StaticResource CardToggleSwitchStyle}"
                                      x:Uid="MouseDownSwitch" Toggled="MouseDownSwitch_Toggled" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7C9;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="PressureTitle" />
                        <TextBlock x:Name="ThresholdDescription" Style="{StaticResource CardDescriptionStyle}"
                                   x:Uid="PressureDescription" />
                    </StackPanel>
                    <NumberBox x:Name="ThresholdBox" Grid.Column="2" Width="150" VerticalAlignment="Center"
                               SpinButtonPlacementMode="Inline" SmallChange="10" LargeChange="50"
                               x:Uid="ThresholdBox" ValueChanged="ThresholdBox_ValueChanged" />
                </Grid>

                <Button x:Name="ResetButton" x:Uid="ResetButton" HorizontalAlignment="Right" Margin="0,12,0,0"
                        Click="ResetButton_Click" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
