<Project>
  <PropertyGroup>
    <!-- Major version of every project. Change it by hand to start developing a new major version.
         The rest of the version is worked out for each build by installer\version.ps1 (see docs\technical.md) -->
    <VersionMajor>1</VersionMajor>
    <!-- Building without installer\build.ps1 (an IDE, plain dotnet build) is a local build -->
    <Version>$(VersionMajor).0.0.0</Version>
    <!-- installer\build.ps1 writes the commit into the product version itself -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
